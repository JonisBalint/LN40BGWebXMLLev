<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ===================== EGYSZERŰ TÍPUSOK ===================== -->

    <!-- Rendszám formátum: 3 nagybetű, kötőjel, 3 szám -->
    <xs:simpleType name="RendszamType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3}-[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IDType">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>
 
    <xs:simpleType name="TelefonType">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="PenzType">
        <xs:restriction base="xs:int"/>
    </xs:simpleType>

    <xs:simpleType name="EvType">
        <xs:restriction base="xs:int"/>
    </xs:simpleType>

    <!-- ===================== KOMPLEX TÍPUSOK ===================== -->

    <!-- Cím típus -->
    <xs:complexType name="CimType">
        <xs:sequence>
            <xs:element name="Varos" type="xs:string"/>
            <xs:element name="Utca" type="xs:string"/>
            <xs:element name="Hazszam" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Tulaj típus -->
    <xs:complexType name="TulajType">
        <xs:sequence>
            <xs:element name="Tulaj_ID" type="IDType"/>
            <xs:element name="Nev" type="xs:string"/>
            <!-- Többértékű tulajdonság: több Telszam egy Tulajnál -->
            <xs:element name="Telszam" type="TelefonType" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="Cim" type="CimType"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Autó típus -->
    <xs:complexType name="AutoType">
        <xs:sequence>
            <xs:element name="Rendszam" type="RendszamType"/>
            <xs:element name="Tulaj_FK" type="IDType"/>
            <xs:element name="Marka" type="xs:string"/>
            <xs:element name="Tipus" type="xs:string"/>
            <xs:element name="Gyartasi_ev" type="EvType"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Biztosítás típus -->
    <xs:complexType name="BiztositasType">
        <xs:sequence>
            <xs:element name="Bizt_ID" type="IDType"/>
            <xs:element name="Biztosito" type="xs:string"/>
            <xs:element name="Tipus" type="xs:string"/>
            <xs:element name="Dij" type="PenzType"/>
            <xs:element name="Rsz_FK" type="RendszamType"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Baleset típus -->
    <xs:complexType name="BalesetType">
        <xs:sequence>
            <xs:element name="Baleset_ID" type="IDType"/>
            <xs:element name="Rsz_BFK" type="RendszamType"/>
            <xs:element name="Datum" type="xs:date"/>
            <xs:element name="Helyszin" type="xs:string"/>
            <xs:element name="Leiras" type="xs:string"/>
            <xs:element name="Kar" type="PenzType"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Szerviz típus -->
    <xs:complexType name="SzervizType">
        <xs:sequence>
            <xs:element name="Szerviz_ID" type="IDType"/>
            <xs:element name="Baleset_FK" type="IDType"/>
            <xs:element name="Telszam" type="TelefonType"/>
            <xs:element name="Cim" type="xs:string"/>
            <xs:element name="Nev" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Részvétel (a balesetben) -->
    <xs:complexType name="ReszvetelType">
        <xs:sequence>
            <xs:element name="Baleset_FK" type="IDType"/>
            <xs:element name="Rendszam_FK" type="RendszamType"/>
            <xs:element name="Okozo" type="xs:string"/>
            <xs:element name="Karosult" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="Tulaj" type="TulajType"/>
    <xs:element name="Auto" type="AutoType"/>
    <xs:element name="Biztositas" type="BiztositasType"/>
    <xs:element name="Baleset" type="BalesetType"/>
    <xs:element name="Szerviz" type="SzervizType"/>
    <xs:element name="Reszvetel" type="ReszvetelType"/>


    <xs:element name="Autonyilvantartas">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="Tulaj" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="Auto" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="Biztositas" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="Baleset" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="Szerviz" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="Reszvetel" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>

        <!-- ===================== PK ===================== -->

        <!-- Tulaj primary key: Tulaj_ID -->
        <xs:key name="Tulaj_PK">
            <xs:selector xpath="Tulaj"/>
            <xs:field xpath="Tulaj_ID"/>
        </xs:key>

        <!-- Autó primary key: Rendszam -->
        <xs:key name="Auto_PK">
            <xs:selector xpath="Auto"/>
            <xs:field xpath="Rendszam"/>
        </xs:key>

        <!-- Biztosítás primary key: Bizt_ID -->
        <xs:key name="Biztositas_PK">
            <xs:selector xpath="Biztositas"/>
            <xs:field xpath="Bizt_ID"/>
        </xs:key>

        <!-- Baleset primary key: Baleset_ID -->
        <xs:key name="Baleset_PK">
            <xs:selector xpath="Baleset"/>
            <xs:field xpath="Baleset_ID"/>
        </xs:key>

        <!-- Szerviz primary key: Szerviz_ID -->
        <xs:key name="Szerviz_PK">
            <xs:selector xpath="Szerviz"/>
            <xs:field xpath="Szerviz_ID"/>
        </xs:key>

        <!-- ===================== FK ===================== -->

        <!-- Autó.Tulaj_FK -> Tulaj.Tulaj_ID -->
        <xs:keyref name="Auto_Tulaj_FK" refer="Tulaj_PK">
            <xs:selector xpath="Auto"/>
            <xs:field xpath="Tulaj_FK"/>
        </xs:keyref>

        <!-- Biztositas.Rsz_FK -> Auto.Rendszam -->
        <xs:keyref name="Biztositas_Auto_FK" refer="Auto_PK">
            <xs:selector xpath="Biztositas"/>
            <xs:field xpath="Rsz_FK"/>
        </xs:keyref>

        <!-- Baleset.Rsz_BFK -> Auto.Rendszam -->
        <xs:keyref name="Baleset_Auto_FK" refer="Auto_PK">
            <xs:selector xpath="Baleset"/>
            <xs:field xpath="Rsz_BFK"/>
        </xs:keyref>

        <!-- Szerviz.Baleset_FK -> Baleset.Baleset_ID -->
        <xs:keyref name="Szerviz_Baleset_FK" refer="Baleset_PK">
            <xs:selector xpath="Szerviz"/>
            <xs:field xpath="Baleset_FK"/>
        </xs:keyref>

        <!-- Reszvetel.Baleset_FK -> Baleset.Baleset_ID -->
        <xs:keyref name="Reszvetel_Baleset_FK" refer="Baleset_PK">
            <xs:selector xpath="Reszvetel"/>
            <xs:field xpath="Baleset_FK"/>
        </xs:keyref>

        <!-- Reszvetel.Rendszam_FK -> Auto.Rendszam -->
        <xs:keyref name="Reszvetel_Auto_FK" refer="Auto_PK">
            <xs:selector xpath="Reszvetel"/>
            <xs:field xpath="Rendszam_FK"/>
        </xs:keyref>

<!-- ===================== 1:1 KAPCSOLAT A  SZERVIZ – BALESET-RE, MERT NEM JÓL CSINÁLTAM ===================== -->

<!-- Egy balesethez legfeljebb egy szerviz tartozhat -->
        <xs:unique name="Szerviz_Baleset_Unique">
            <xs:selector xpath="Szerviz"/>
            <xs:field xpath="Baleset_FK"/>
        </xs:unique>

    </xs:element>

</xs:schema>

